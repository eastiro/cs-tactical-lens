# ── 默认文本文件统一使用 LF ──
* text=auto eol=lf

# ── Windows 脚本使用 CRLF ──
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# ── 代码与文档：文本 + LF ──
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# ── 二进制文件 ──
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.gz binary
*.dem binary
*.rar binary
*.zip binary
*.ico binary
*.woff2 binary
